# ─────────────────────────────────────────────────────────────────────
# DEV environment — loaded ONLY when running `vite` / `npm run dev`
# (Vite mode = "development"). Overrides the production values in `.env`.
# ─────────────────────────────────────────────────────────────────────

# API base URL (development backend)
VITE_API_BASE_URL=https://dev.dynamicsroute.tech

# WebSocket URL (development backend)
VITE_WEBSOCKET_URL=https://dev.dynamicsroute.tech

# JWT token expiration time in days
VITE_JWT_EXPIRATION_DAYS=7

# Application debug mode
VITE_APP_DEBUG=true