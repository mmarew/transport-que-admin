# ─────────────────────────────────────────────────────────────────────
# Environment variables — copy to `.env` (production) and
# `.env.development` (local dev) and fill in actual values.
#
#   `.env`              → loaded for `vite build` (production backend)
#   `.env.development`  → loaded for `npm run dev` (development backend,
#                         overrides `.env`)
#
# Only `.env.example` is committed; `.env` and `.env.*` are gitignored.
# ─────────────────────────────────────────────────────────────────────

# API base URL
VITE_API_BASE_URL=https://your-api-domain.com

# WebSocket URL
VITE_WEBSOCKET_URL=https://your-api-domain.com

# JWT token expiration time in days
VITE_JWT_EXPIRATION_DAYS=7

# Application debug mode
VITE_APP_DEBUG=false